name: Deploy Dashboard to GitHub Pages

on:
  push:
    branches: [main]
    paths:
      - 'dashboard/**'      # solo dispara si cambia el dashboard
  workflow_dispatch:        # permite dispararlo a mano desde Actions tab

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      # Copia el dashboard a una carpeta temporal "site" (requisito de Pages)
      - name: Prepare site
        run: |
          mkdir site
          cp dashboard/andre_mundial2026.html site/index.html

      - name: Upload artifact
        uses: actions/upload-pages-artifact@
        with:
          path: site

  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
